# Arquivo de exemplo das variáveis de ambiente
# Copie este arquivo e ajuste os valores conforme necessário

# Configurações
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db-name
TELEGRAM_API_URL=URL
TELEGRAM_API_TOKEN=TOKEN

# Auth
JWT_SECRET=your-secret-key-change-in-production
# OAuth Client ID (tipo "Web") do Google Cloud Console, o mesmo usado pelo frontend
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
